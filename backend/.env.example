# 复制为 .env 后按需修改：cp .env.example .env
# 环境变量优先级高于 .env 文件。

# local | dev | test | prod
APP_ENV=local
DEBUG=true

# 服务监听地址
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库：默认 sqlite（零依赖），也可切换 PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://vnpy:password@localhost:5432/vnpy_rebuild
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# 日志：DEBUG / INFO / WARNING / ERROR / CRITICAL；log_json=true 输出 JSON
LOG_LEVEL=INFO
LOG_JSON=false

# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
